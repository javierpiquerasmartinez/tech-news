# Copia este fichero a .env (está en .gitignore) y rellena lo que uses.

# Bot de Telegram para los avisos (créalo con @BotFather). El chat lo rellena
# `uv run tn avisos vincular` después de que le escribas al bot.
TN_TELEGRAM_TOKEN=
TN_TELEGRAM_CHAT=

# Carpeta de las copias de seguridad diarias (por defecto ~/Documents/tech-news-respaldos)
# TN_RESPALDOS=~/Documents/tech-news-respaldos

# Modelo de los agentes (por defecto sonnet)
# TN_MODELO=sonnet

# Máximo de Items que edita la Ejecución diaria (el resto queda para el día siguiente)
# TN_MAX_ITEMS_DIARIO=200

# Clave de la API de Gemini (Google AI Studio) para generar imágenes, vídeo o voz.
# Solo se usa con aprobación previa de la persona editora en cada uso (ver docs/arnes.md §9).
TN_GEMINI_API_KEY=
